# Template for the local .env file. Copy to .env and fill in real values:
#
#   cp .env.example .env
#
# .env is gitignored and must stay that way. In AWS these same variables come
# from SSM Parameter Store instead of a file.

# --- Database ---------------------------------------------------------------
# DB_NAME is read by docker-compose.yml, which creates the database and derives
# the API's DB_URL from it. DB_URL below is only used when the API runs outside
# Compose — from an IDE, or via ./mvnw spring-boot:run — against the database
# container on its published port. Compose overrides it for the API container,
# where the database answers to `db` rather than to localhost.
DB_NAME=papapreco
DB_URL=jdbc:postgresql://localhost:5432/papapreco
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Database migrations ----------------------------------------------------
# Flyway applies these during startup. classpath:db/migration is the schema and
# is always applied. classpath:db/seed is the demo dataset — twelve shops,
# five accounts and a few dozen prices — and is listed here so that a fresh
# `docker compose up` has something to show.
#
# Drop the seed location when deploying. Every seeded account has the published
# password `demo1234`, which is only acceptable on a machine somebody chose to
# put it on:
#
#   FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# --- Mail (Gmail SMTP) ------------------------------------------------------
# MAIL_PASSWORD is a Google App Password, not the account password. Generate it
# at https://myaccount.google.com/apppasswords with the spaces removed.
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=change-me

# --- Credential file locations ----------------------------------------------
# Spring resource locations. Defaults point at ./secrets/, which is gitignored;
# override when the files are mounted somewhere else, as in a container.
#JWT_PUBLIC_KEY_LOCATION=file:./secrets/jwt.rsa.pub
#JWT_PRIVATE_KEY_LOCATION=file:./secrets/jwt.rsa.priv
#FIREBASE_CREDENTIALS_LOCATION=file:./secrets/firebase-service-account.json

# --- Optional ---------------------------------------------------------------
#SERVER_PORT=8080
#JPA_SHOW_SQL=true
# Verbose logging for debugging only. LOG_LEVEL_SQL_PARAMS=TRACE prints bound
# SQL parameters, which includes password hashes and verification codes.
#LOG_LEVEL_JPA=DEBUG
#LOG_LEVEL_SECURITY=TRACE
#LOG_LEVEL_SQL=DEBUG
#LOG_LEVEL_SQL_PARAMS=TRACE
